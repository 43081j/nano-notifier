{
  "name": "nano-updater",
  "version": "0.0.0-dev",
  "description": "Notifiers users of your CLI when an update is available.",
  "main": "./lib/main.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/main.d.ts",
      "default": "./lib/main.js"
    }
  },
  "files": [
    "lib",
    "!lib/**/*.test.js",
    "!lib/**/*.test.d.ts"
  ],
  "scripts": {
    "build:clean": "node -e \"require('fs').rmSync('./lib', { recursive: true, force: true })\"",
    "build": "npm run build:clean && tsgo",
    "lint:js": "oxlint src",
    "lint:format": "oxfmt --check src",
    "lint": "npm run lint:js && npm run lint:format",
    "format": "oxfmt --write src",
    "test": "npm run build && vitest run"
  },
  "keywords": [
    "notifier",
    "update",
    "cli",
    "updates"
  ],
  "author": "James Garbutt (https://github.com/43081j)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/43081j/nano-updater#readme",
  "bugs": {
    "url": "https://github.com/43081j/nano-updater/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/43081j/nano-updater.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript/native-preview": "^7.0.0-dev.20260509.2",
    "@vitest/coverage-v8": "^5.0.1",
    "ansivision": "^0.4.0",
    "oxfmt": "^0.69.0",
    "oxlint": "^1.63.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "verkit": "^0.5.0"
  }
}
